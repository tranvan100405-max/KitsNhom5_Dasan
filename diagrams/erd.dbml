// DASAN Firmware Rollout Platform - Revised ERD (Cross-review Aligned)
// Explicit enums, nullability, indexes, check constraints, and integrity notes.

Enum MemberRole {
  ADMIN
  DEVELOPER
  QA
  OPERATOR
}

Enum DeviceType {
  SWITCH
  ROUTER
  ONT
  ONU
}

Enum ConnectivityStatus {
  ONLINE
  OFFLINE
}

Enum ActivePartition {
  A
  B
}

Enum FirmwareStatus {
  UPLOADED
  APPROVED
  DEPRECATED
}

Enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  ABORTED
}

// Aligned with Team Convention (§1.1): no FAILED/SKIPPED on wave; wave failure pauses Campaign.
Enum WaveStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
}

Enum DeviceTaskStatus {
  PENDING
  DOWNLOADING
  INSTALLING
  VERIFYING
  SUCCESS
  FAILED
  TIMEOUT
  ROLLED_BACK
}

Enum AuditActorType {
  MEMBER
  SYSTEM
  DEVICE
}

Table members {
  id uuid [pk, not null]
  email varchar [unique, not null]
  name varchar [not null]
  role MemberRole [not null]
  createdAt datetime [not null]
}

Table device_groups {
  id uuid [pk, not null]
  name varchar [not null]
  customerName varchar [not null]
  region varchar [not null]
  timezone varchar [null]
  maintenanceWindow varchar [null]

  Note: 'timezone (IANA, e.g. Asia/Ho_Chi_Minh) and maintenanceWindow (e.g. 01:00-05:00) support Bonus #14 per-ISP maintenance windows.'
}

Table devices {
  id uuid [pk, not null]
  serialNo varchar [unique, not null]
  model varchar [not null]
  deviceType DeviceType [not null]
  groupId uuid [not null]
  currentFirmwareId uuid [null]
  connectivity ConnectivityStatus [not null]
  lastCheckInAt datetime [null]
  activePartition ActivePartition [null]

  indexes {
    (groupId, model) [name: 'idx_devices_group_model']
  }

  Note: 'Device HMAC secrets / mTLS credentials are stored in an isolated KMS / device_credentials(deviceId, secret, createdAt) store, separated from devices so admin read APIs never expose secrets.'
}

Table firmware_versions {
  id uuid [pk, not null]
  model varchar [not null]
  versionNo varchar [not null]
  versionCode int [not null]
  releaseNotes text [null]
  checksum varchar [not null]
  fileUrl varchar [not null]
  minRequiredVersion varchar [not null]
  minRequiredVersionCode int [not null]
  status FirmwareStatus [not null]
  uploadedBy uuid [not null]
  approvedBy uuid [null]
  createdAt datetime [not null]

  indexes {
    (model, versionNo) [unique, name: 'uq_firmware_model_version']
    (model, status) [name: 'idx_firmware_model_status']
  }

  checks {
    `minRequiredVersionCode <= versionCode` [name: 'chk_firmware_min_version']
    `approvedBy IS NULL OR uploadedBy <> approvedBy` [name: 'chk_four_eyes']
  }

  Note: 'versionCode uses numeric encoding MAJOR*10000 + MINOR*100 + PATCH (e.g. v2.4.1 -> 20401, Q8). approvedBy remains NULL until QA approval; CHECK constraints enforce valid version range and four-eyes rule.'
}

Table campaigns {
  id uuid [pk, not null]
  name varchar [not null]
  firmwareId uuid [not null]
  targetGroupId uuid [not null]
  status CampaignStatus [not null]
  failureThresholdPercent decimal [not null]
  maxConcurrentDevices int [not null]
  createdBy uuid [not null]
  scheduledAt datetime [null]
  startedAt datetime [null]
  finishedAt datetime [null]

  indexes {
    (targetGroupId, status) [name: 'idx_campaign_group_status']
  }
}

Table campaign_waves {
  id uuid [pk, not null]
  campaignId uuid [not null]
  waveOrder int [not null]
  rolloutPercentage decimal [not null]
  minSuccessRateToProceed decimal [not null]
  status WaveStatus [not null]
  deadlineAt datetime [null]
  startedAt datetime [null]
  finishedAt datetime [null]

  indexes {
    (campaignId, waveOrder) [unique, name: 'uq_wave_campaign_order']
  }

  Note: 'rolloutPercentage is cumulative (1% -> 10% -> 50% -> 100%, Q1). deadlineAt remains NULL while wave is PENDING and is set (default startedAt + 24h, Q7) when wave enters RUNNING.'
}

Table device_tasks {
  id uuid [pk, not null]
  campaignId uuid [not null]
  waveId uuid [not null]
  deviceId uuid [not null]
  fromFirmwareId uuid [not null]
  toFirmwareId uuid [not null]
  status DeviceTaskStatus [not null]
  attemptCount int [not null]
  errorCode varchar [null]
  errorMessage text [null]
  startedAt datetime [null]
  finishedAt datetime [null]
  lastHeartbeatAt datetime [null]

  indexes {
    (campaignId, status) [name: 'idx_tasks_campaign_status']
    (deviceId, status) [name: 'idx_tasks_device_status']
    (waveId, status) [name: 'idx_tasks_wave_status']
  }

  Note: 'PostgreSQL DDL also enforces partial unique index uq_active_device_task ON device_tasks(deviceId) WHERE status IN (PENDING, DOWNLOADING, INSTALLING, VERIFYING). Failed or rolled-back attempts remain recorded here.'
}

Table device_firmware_histories {
  id uuid [pk, not null]
  deviceId uuid [not null]
  firmwareId uuid [not null]
  taskId uuid [not null, unique]
  installedAt datetime [not null]

  Note: 'One successful device_task produces zero or one history row (1:0..1, taskId is UNIQUE). History is inserted in the same transaction that marks the task SUCCESS and updates devices.currentFirmwareId.'
}

Table audit_logs {
  id uuid [pk, not null]
  actorId uuid [null]
  actorType AuditActorType [not null]
  action varchar [not null]
  targetType varchar [not null]
  targetId varchar [not null]
  detail json [null]
  createdAt datetime [not null]

  indexes {
    (targetType, targetId, createdAt) [name: 'idx_audit_target_created']
    (createdAt) [name: 'idx_audit_created']
  }

  checks {
    `(actorType = 'MEMBER' AND actorId IS NOT NULL) OR (actorType IN ('SYSTEM', 'DEVICE') AND actorId IS NULL)` [name: 'chk_audit_actor_reference']
  }

  Note: 'Append-only audit trail. actorId references members.id only when actorType = MEMBER. For SYSTEM or DEVICE events actorId must be NULL and device/system metadata is stored in detail JSON.'
}

// Relationships
Ref: members.id < firmware_versions.uploadedBy
Ref: members.id < firmware_versions.approvedBy
Ref: members.id < campaigns.createdBy
Ref: members.id < audit_logs.actorId

Ref: device_groups.id < devices.groupId
Ref: device_groups.id < campaigns.targetGroupId

Ref: firmware_versions.id < campaigns.firmwareId
Ref: firmware_versions.id < devices.currentFirmwareId
Ref: firmware_versions.id < device_tasks.fromFirmwareId
Ref: firmware_versions.id < device_tasks.toFirmwareId
Ref: firmware_versions.id < device_firmware_histories.firmwareId

Ref: campaigns.id < campaign_waves.campaignId
Ref: campaigns.id < device_tasks.campaignId

Ref: campaign_waves.id < device_tasks.waveId

Ref: devices.id < device_tasks.deviceId
Ref: devices.id < device_firmware_histories.deviceId

// One task has zero or one verified history row (taskId is UNIQUE).
Ref: device_tasks.id - device_firmware_histories.taskId
