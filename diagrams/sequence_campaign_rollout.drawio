        <!-- Phase 1: Create Campaign -->
        <mxCell id="g1" value="Giai đoạn 1: Tạo &amp; Khởi chạy Chiến dịch (Start Campaign &amp; Concurrency Lock)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#CBD5E0;align=left;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#2D3748;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="1310" height="245" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="1. POST /api/campaigns (firmwareId, targetGroupId, waves, failureThreshold)" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#2B6CB0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="175" as="sourcePoint" />
            <mxPoint x="325" y="175" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2. Insert Campaign (DRAFT) &amp; campaign_waves (1%, 10%, 50%, 100%)" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#2B6CB0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="325" y="205" as="sourcePoint" />
            <mxPoint x="795" y="205" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3. 201 Created (campaignId)" style="endArrow=open;dashed=1;html=1;fontSize=11;strokeColor=#4A5568;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="325" y="230" as="sourcePoint" />
            <mxPoint x="105" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m4" value="4. PATCH /api/campaigns/{id}/start" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#2B6CB0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="265" as="sourcePoint" />
            <mxPoint x="325" y="265" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5. Acquire Lock(targetGroupId) - Chống 2 Operator Start trùng" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#C05621;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="325" y="290" as="sourcePoint" />
            <mxPoint x="555" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6. Lọc thiết bị hợp lệ (Model, &gt;= minVersion, không trùng active task) &amp; chia Wave&#xa;    Tạo device_tasks (PENDING) + Đổi Campaign=RUNNING, Wave 1=RUNNING" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#6B46C1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="325" y="325" as="sourcePoint" />
            <mxPoint x="795" y="325" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7. 200 OK (Wave 1: 1% Canary đã mở)" style="endArrow=open;dashed=1;html=1;fontSize=11;strokeColor=#4A5568;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="325" y="360" as="sourcePoint" />
            <mxPoint x="105" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Phase 2: Check-in & Rate Limiting -->
        <mxCell id="g2" value="Giai đoạn 2: Thiết bị Check-in &amp; Giới hạn tải tải xuống (maxConcurrentDevices)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F6E05E;align=left;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#744210;" vertex="1" parent="1">
          <mxGeometry x="40" y="395" width="1310" height="235" as="geometry" />
        </mxCell>

        <mxCell id="m8" value="8. POST /api/device-agent/check-in (mỗi 5 phút + Random Jitter)" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#C53030;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1270" y="435" as="sourcePoint" />
            <mxPoint x="325" y="435" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="9. Tìm task PENDING thuộc Wave đang RUNNING của thiết bị" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#6B46C1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="325" y="465" as="sourcePoint" />
            <mxPoint x="795" y="465" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="10. Lấy 1 Token từ sem:campaign:{id} (Active Downloads &lt; maxConcurrentDevices?)" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#C05621;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="325" y="495" as="sourcePoint" />
            <mxPoint x="555" y="495" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m11" value="11. [Nếu còn Slot] Cập nhật task = DOWNLOADING" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#6B46C1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="325" y="525" as="sourcePoint" />
            <mxPoint x="795" y="525" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="12. Trả về Task (Pre-signed URL + SHA-256) | hoặc NO_TASK nếu hết slot / chưa tới Wave" style="endArrow=open;dashed=1;html=1;fontSize=11;strokeColor=#2F855A;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="325" y="560" as="sourcePoint" />
            <mxPoint x="1270" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m13" value="13. POST /api/device-agent/tasks/{taskId}/result (stage=INSTALLING -&gt; trả Token tải; cuối: SUCCESS/FAILED/ROLLED_BACK)" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#C53030;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1270" y="600" as="sourcePoint" />
            <mxPoint x="325" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Phase 3: Wave Promotion & Auto-Pause -->
        <mxCell id="g3" value="Giai đoạn 3: Giám sát Wave, Tự động Tạm dừng (Auto-Pause) &amp; Mở đợt tiếp theo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#9AE6B4;align=left;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#22543D;" vertex="1" parent="1">
          <mxGeometry x="40" y="645" width="1310" height="230" as="geometry" />
