        <mxCell id="m15" value="15. Tính FailureRate (khi đủ cỡ mẫu tối thiểu N &gt;= 50)" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#B7791F;" edge="1" parent="1">
