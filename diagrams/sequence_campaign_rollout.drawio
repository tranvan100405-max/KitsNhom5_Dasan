              <mxPoint x="1120" y="745" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m16" value="16a. [Nếu FailureRate &gt; Threshold] Đổi Campaign=PAUSED, Wave=PAUSED" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#C53030;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1040" y="775" as="sourcePoint" />
            <mxPoint x="795" y="775" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m17" value="16b. Gửi Cảnh báo khẩn (Alert) lên Dashboard cho Operator" style="endArrow=open;dashed=1;html=1;fontSize=11;strokeColor=#C53030;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1040" y="805" as="sourcePoint" />
            <mxPoint x="105" y="805" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m18" value="17. [Nếu SuccessRate &gt;= 95% &amp; Đủ Soak Time] Đóng Wave 1 = COMPLETED, mở Wave 2 = RUNNING" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#2F855A;" edge="1" parent="1">
