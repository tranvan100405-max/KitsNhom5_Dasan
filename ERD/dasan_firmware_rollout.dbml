Table members {
  id uuid [pk]
  email varchar [unique]
  name varchar
  role varchar
  createdAt datetime
}

Table device_groups {
  id uuid [pk]
  name varchar
  customerName varchar
  region varchar
  timezone varchar
  maintenanceWindow varchar
}

Table devices {
  id uuid [pk]
  serialNo varchar [unique]
  model varchar
  deviceType varchar
  groupId uuid
  currentFirmwareId uuid
  connectivity varchar
  lastCheckInAt datetime
  activePartition varchar
}

Table firmware_versions {
  id uuid [pk]
  model varchar
  versionNo varchar
  versionCode int
  releaseNotes text
  checksum varchar
  fileUrl varchar
  minRequiredVersion varchar
  minRequiredVersionCode int
  status varchar
  uploadedBy uuid
  approvedBy uuid
  createdAt datetime
}

Table campaigns {
  id uuid [pk]
  name varchar
  firmwareId uuid
  targetGroupId uuid
  status varchar
  failureThresholdPercent decimal
  maxConcurrentDevices int
  createdBy uuid
  scheduledAt datetime
  startedAt datetime
  finishedAt datetime
}

Table campaign_waves {
  id uuid [pk]
  campaignId uuid
  waveOrder int
  rolloutPercentage decimal
  minSuccessRateToProceed decimal
  status varchar
  deadlineAt datetime
  startedAt datetime
  finishedAt datetime
}

Table device_tasks {
  id uuid [pk]
  campaignId uuid
  waveId uuid
  deviceId uuid
  fromFirmwareId uuid
  toFirmwareId uuid
  status varchar
  attemptCount int
  errorCode varchar
  errorMessage text
  startedAt datetime
  finishedAt datetime
  lastHeartbeatAt datetime
}

Table device_firmware_histories {
  id uuid [pk]
  deviceId uuid
  firmwareId uuid
  taskId uuid
  installedAt datetime
}

Table audit_logs {
  id uuid [pk]
  actorId uuid
  actorType varchar
  action varchar
  targetType varchar
  targetId varchar
  detail json
  createdAt datetime
}

// Relationships
Ref: members.id < firmware_versions.uploadedBy
Ref: members.id < firmware_versions.approvedBy
Ref: members.id < campaigns.createdBy
Ref: members.id < audit_logs.actorId

Ref: device_groups.id < devices.groupId
Ref: device_groups.id < campaigns.targetGroupId

Ref: firmware_versions.id < campaigns.firmwareId
Ref: firmware_versions.id < devices.currentFirmwareId
Ref: firmware_versions.id < device_tasks.fromFirmwareId
Ref: firmware_versions.id < device_tasks.toFirmwareId
Ref: firmware_versions.id < device_firmware_histories.firmwareId

Ref: campaigns.id < campaign_waves.campaignId
Ref: campaigns.id < device_tasks.campaignId

Ref: campaign_waves.id < device_tasks.waveId

Ref: devices.id < device_tasks.deviceId
Ref: devices.id < device_firmware_histories.deviceId

Ref: device_tasks.id < device_firmware_histories.taskId
